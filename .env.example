# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEON POSTGRESQL CONFIGURATION
# DATABASE_URL: Neon pooled connection string for application queries (pgBouncer / pooler)
# Format: postgresql://USER:PASSWORD@ep-xyz-pooler.REGION.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-xyz-pooler.us-east-2.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Neon direct unpooled connection string (used by Prisma 6 for migrations)
# Format: postgresql://USER:PASSWORD@ep-xyz.REGION.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://neondb_owner:password@ep-xyz.us-east-2.neon.tech/neondb?sslmode=require"

# TEST_DATABASE_URL: Optional dedicated Neon branch connection string for isolated CI/CD tests
# Format: postgresql://USER:PASSWORD@ep-test-branch-pooler.REGION.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL="postgresql://neondb_owner:password@ep-test-branch-pooler.us-east-2.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="gamehub_secret_key_change_me_in_production"

# IGDB API credentials (Twitch Developer Portal)
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"

PORT=3000
